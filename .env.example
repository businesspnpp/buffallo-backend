# ── Supabase ──────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Frontend ───────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash)
FRONTEND_URL=https://buffalopayment.vercel.app

# ── Admin ─────────────────────────────────────────────────────────
# Secret key required to access GET /api/links — set a strong random value
ADMIN_KEY=your-strong-random-secret-here

# ── Server ────────────────────────────────────────────────────────
PORT=3000
